# Collie environment template. Copy to collie.env (git ignores it).

# Turn off Paperclip telemetry.
PAPERCLIP_TELEMETRY_DISABLED=1
DO_NOT_TRACK=1

# Server port. The server reads the PORT variable
# (server/src/config.ts: Number(process.env.PORT) || file config || 3100).
# 3100 is the default. Another app on this machine uses 3100, so use 3200.
PORT=3200
